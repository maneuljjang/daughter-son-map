# 카카오 디벨로퍼스 > 앱 > 플랫폼 키 > JavaScript 키
VITE_KAKAO_JS_KEY=

# (선택) 카톡 카드 이미지의 절대 주소. 비워 두면 배포 주소의 share/invite-card.png 를 씁니다.
# 로컬(localhost)에서 공유를 시험할 때는 배포된 이미지 주소를 넣어 두면 카드 이미지가 보여요.
VITE_SHARE_IMAGE_URL=

# (2차) 부모님 의견 저장 방식: kakao(기본) | firestore
VITE_FEEDBACK=kakao

# SK open API > TMAP > appKey (있으면 실제 걷는 길로 거리·경로를 계산, 없으면 직선 × 1.3 추정치)
VITE_TMAP_KEY=
